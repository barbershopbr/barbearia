{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "usebrcontrol",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Variáveis não secretas. Chaves privadas (SUPABASE_SERVICE_ROLE_KEY,
  // RESEND_API_KEY, CLOUDFLARE_API_TOKEN) vão por `wrangler secret put`.
  // APP_ORIGIN: deploy provisório no workers.dev (links por caminho
  // /sites/{slug} e /master). Remover quando o DNS de usebrcontrol.com.br
  // apontar para o Worker — aí os links passam a usar os subdomínios.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ifaqsuxxrinpgzfvqvva.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlmYXFzdXh4cmlucGd6ZnZxdnZhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI4Mjg2MjksImV4cCI6MjEwODQwNDYyOX0.K1LtMvj-a9sBPfuzKT7ZVrsQ_8ew-TuEdY0E91oybMM",
    "NEXT_PUBLIC_ROOT_DOMAIN": "usebrcontrol.com.br",
    "APP_ORIGIN": "https://usebrcontrol.usebrcontrol.workers.dev"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "usebrcontrol"
    }
  ],
  // Cache de resolução domínio-próprio -> slug (lib/tenant/domain.ts). Criar
  // com `wrangler kv namespace create TENANT_DOMAINS` e substituir o "id"
  // abaixo pelo retornado (e o "preview_id" por um `wrangler kv namespace
  // create TENANT_DOMAINS --preview`, para rodar `wrangler dev`/preview).
  "kv_namespaces": [
    {
      "binding": "TENANT_DOMAINS",
      "id": "81e88327b3204280aa664a0053f04c48",
      "preview_id": "6a41055bf2ab4471aefb6ff19d3ae4f4"
    }
  ]
}
