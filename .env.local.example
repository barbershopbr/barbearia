# Supabase — crie um projeto em https://supabase.com e copie estes valores em
# Project Settings > API. Copie este arquivo para ".env.local" e preencha.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domínio raiz da plataforma (sem subdomínio). Em dev local use lvh.me.
NEXT_PUBLIC_ROOT_DOMAIN=usebrcontrol.com.br
NEXT_PUBLIC_ROOT_DOMAIN_DEV=lvh.me:3000

# Provisionamento de domínio próprio por empresa (Cloudflare for SaaS /
# Custom Hostnames — ver lib/cloudflare/custom-hostnames.ts). Token
# escopado só na zona usebrcontrol.com.br (não a Global API Key).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
